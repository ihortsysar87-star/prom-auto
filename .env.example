TELEGRAM_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

PROM_API_TOKEN=
PROM_REGION=Київ

IMGBB_API_KEY=

SALES_GROUP_CHAT_ID=
MANAGER_CONTACT_URL=

# OLX.ua API (see prom_auto/olx_auth_setup.py to obtain OLX_REFRESH_TOKEN)
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REFRESH_TOKEN=
OLX_ADVERTISER_TYPE=private
OLX_CONTACT_NAME=
OLX_CONTACT_PHONE=
OLX_CITY_ID=
OLX_DISTRICT_ID=
OLX_CONDITION=new

# Rozetka feed validation hash (see prom_auto/rozetka_backfill.py) - the
# "hash=" query param from https://seller.rozetka.com.ua/gomer/pricevalidate/check/items?hash=...
ROZETKA_VALIDATE_HASH=

# Rozetka Marketplace's own direct seller API (seller.rozetka.com.ua) -
# separate account from PROM_API_TOKEN above. Used by rozetka_client.py.
# Either set an access token generated in the seller panel...
ROZETKA_SELLER_ACCESS_TOKEN=
# ...or username/password to log in as (used only if the token above is blank).
ROZETKA_SELLER_USERNAME=
ROZETKA_SELLER_PASSWORD=
